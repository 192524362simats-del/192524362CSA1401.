#include <stdio.h>
#include <ctype.h>
#include <string.h>

#define MAX 50

int isOperator(char ch)
{
    return ch == '+' || ch == '-' || ch == '*' || ch == '/' ||
           ch == '%' || ch == '=' || ch == '<' || ch == '>' ||
           ch == '!' || ch == '&' || ch == '|';
}

int main()
{
    char input[500], token[MAX];
    int i = 0, j;

    printf("Enter the C program:\n");
    fgets(input, sizeof(input), stdin);

    while (input[i] != '\0')
    {
        /* Ignore spaces, tabs and new lines */
        if (input[i] == ' ' || input[i] == '\t' || input[i] == '\n')
        {
            i++;
            continue;
        }

        /* Ignore single-line comments */
        if (input[i] == '/' && input[i + 1] == '/')
        {
            break;
        }

        /* Ignore multi-line comments */
        if (input[i] == '/' && input[i + 1] == '*')
        {
            i += 2;

            while (input[i] != '\0' &&
                  !(input[i] == '*' && input[i + 1] == '/'))
            {
                i++;
            }

            if (input[i] != '\0')
                i += 2;

            continue;
        }

        /* Identify identifiers */
        if (isalpha(input[i]) || input[i] == '_')
        {
            j = 0;

            while (isalnum(input[i]) || input[i] == '_')
            {
                if (j < MAX - 1)
                    token[j++] = input[i];

                i++;
            }

            token[j] = '\0';

            printf("Identifier : %s\n", token);
            continue;
        }

        /* Identify constants */
        if (isdigit(input[i]))
        {
            j = 0;

            while (isdigit(input[i]) || input[i] == '.')
            {
                if (j < MAX - 1)
                    token[j++] = input[i];

                i++;
            }

            token[j] = '\0';

            printf("Constant   : %s\n", token);
            continue;
        }

        /* Identify operators */
        if (isOperator(input[i]))
        {
            if ((input[i] == '=' || input[i] == '<' ||
                 input[i] == '>' || input[i] == '!' ||
                 input[i] == '+' || input[i] == '-' ||
                 input[i] == '&' || input[i] == '|') &&
                input[i + 1] == '=')
            {
                printf("Operator   : %c%c\n", input[i], input[i + 1]);
                i += 2;
            }
            else if ((input[i] == '+' && input[i + 1] == '+') ||
                     (input[i] == '-' && input[i + 1] == '-') ||
                     (input[i] == '&' && input[i + 1] == '&') ||
                     (input[i] == '|' && input[i + 1] == '|'))
            {
                printf("Operator   : %c%c\n", input[i], input[i + 1]);
                i += 2;
            }
            else
            {
                printf("Operator   : %c\n", input[i]);
                i++;
            }

            continue;
        }

        /* Ignore other characters */
        i++;
    }

    return 0;
}
