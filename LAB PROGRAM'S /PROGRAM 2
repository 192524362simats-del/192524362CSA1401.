#include <stdio.h>
#include <string.h>

int main()
{
    char line[500];

    printf("Enter a line: ");
    fgets(line, sizeof(line), stdin);

    if (line[0] == '/' && line[1] == '/')
    {
        printf("It is a single-line comment.\n");
    }
    else if (line[0] == '/' && line[1] == '*')
    {
        if (strstr(line + 2, "*/") != NULL)
            printf("It is a multi-line comment.\n");
        else
            printf("It is an unterminated multi-line comment.\n");
    }
    else
    {
        printf("It is not a comment.\n");
    }

    return 0;
}
