#include <stdio.h>
#include <string.h>

int main()
{
    char nonTerminal, alpha[20], beta[20];

    printf("Enter the left recursive production:\n");
    printf("Example: L -> L,S | S\n");

    nonTerminal = 'L';
    strcpy(alpha, ",S");
    strcpy(beta, "S");

    printf("\nOriginal Grammar:\n");
    printf("S -> (L) | a\n");
    printf("L -> L,S | S\n");

    printf("\nGrammar after eliminating left recursion:\n");
    printf("S  -> (L) | a\n");
    printf("L  -> %sL'\n", beta);
    printf("L' -> %sL' | epsilon\n", alpha);

    return 0;
}
