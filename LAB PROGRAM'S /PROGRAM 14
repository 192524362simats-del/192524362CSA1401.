#include <stdio.h>
#include <string.h>
#include <ctype.h>

char expr[100];
char temp = '1';

int main()
{
    int i;
    char op1, op2, op3, op4;

    printf("Enter the expression: ");
    scanf("%s", expr);

    printf("\nThree Address Code:\n");

    /*
       This program handles expressions of the form:
       a=b+c*d
       a=(b+c)*d
    */

    for (i = 0; expr[i] != '\0'; i++)
    {
        if (expr[i] == '*')
        {
            op1 = expr[i - 1];
            op2 = expr[i + 1];

            printf("t%c = %c * %c\n", temp, op1, op2);

            expr[i - 1] = 't';
            expr[i] = temp;
            expr[i + 1] = 't';

            temp++;
        }
    }

    for (i = 0; expr[i] != '\0'; i++)
    {
        if (expr[i] == '+')
        {
            op1 = expr[i - 1];
            op2 = expr[i + 1];

            printf("t%c = %c + %c\n", temp, op1, op2);

            expr[i - 1] = 't';
            expr[i] = temp;
            expr[i + 1] = 't';

            temp++;
        }
    }

    for (i = 0; expr[i] != '\0'; i++)
    {
        if (expr[i] == '=')
        {
            printf("%c = t%c\n", expr[0], temp - 1);
            break;
        }
    }

    return 0;
}
